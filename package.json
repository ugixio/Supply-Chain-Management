    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "uuid": "^9.0.0",
    "decimal.js": "^10.4.3",
    "date-fns": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "eslint": "^9.4.0",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0"
  },
  "keywords": [
    "supply-chain",
