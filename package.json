{
  "name": "supply-chain-management",
  "version": "1.0.0",
  "description": "Enterprise Supply Chain Management System — SCOR-DS aligned, ISO 28000:2022 compliant",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
